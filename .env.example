# Copy this file to `.env.local` to get a working local setup. Every key below
# is either blank or commented out, and the app falls back to local defaults for
# all of them, so `npm run dev` works with no further editing.
#
# Two forms appear here, and the difference is load-bearing:
#
#   KEY=      an empty value means the same thing as "not set" for this key
#   # KEY=    an empty value would NOT mean "not set" — uncomment before use
#
# The commented ones read their default with `??`, which treats an empty string
# as a real value. Uncommenting one with nothing after the `=` is worse than
# leaving it alone. `.claude/hooks/session-start.sh` copies this file verbatim
# to `.env.local` on every cloud session, so a stray blank line here changes how
# those sessions behave.

# ---------------------------------------------------------------------------
# Payload CMS
# ---------------------------------------------------------------------------

# Signs Payload's session cookies and tokens. Defaults to the literal "local",
# which is fine for development and must never be used in a deployment. Rotating
# it invalidates every existing admin session.
# PAYLOAD_SECRET=

# The Turso (libSQL) database Payload stores content in. BOTH must be set for
# the remote database to be used; with either one missing, Payload falls back to
# the SQLite file at `.data/payload.db`, which is what local development wants.
LIBSQL_PAYLOAD_TURSO_DATABASE_URL=
LIBSQL_PAYLOAD_TURSO_AUTH_TOKEN=

# Seeds a Payload admin user on first run, so a fresh local database is usable
# without going through the signup screen. Both must be set for the seed to run.
# Never point these at real credentials — the seed writes them straight in.
PAYLOAD_TEST_USER_EMAIL=user@btnopen.test
PAYLOAD_TEST_USER_PASSWORD=local

# The key the e2e suite authenticates to the Payload MCP server with. Leave
# empty to skip the MCP scenarios. Create a scoped key in the Payload admin
# under the MCP API Keys collection.
#
# Note that the agent-facing `PAYLOAD_MCP_URL` and `PAYLOAD_MCP_API_KEY` read by
# `.mcp.json` are NOT set here — an MCP client reads them from your shell
# environment, not from `.env.local`. See the README's MCP section.
PAYLOAD_MCP_E2E_API_KEY=

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------

# Enables the Vercel Blob store for uploaded media. Leave empty in local
# development, where uploads are written to disk instead.
BLOB_PAYLOAD_READ_WRITE_TOKEN=

# Namespaces every uploaded file in the Vercel Blob store under this path
# (e.g. `pr-42`). Leave empty in production and local development; preview
# deployments set it to isolate their media and delete the whole prefix on
# teardown. Only takes effect when BLOB_PAYLOAD_READ_WRITE_TOKEN is set.
BLOB_PAYLOAD_PREFIX=

# ---------------------------------------------------------------------------
# Comment authentication
# ---------------------------------------------------------------------------

# Clerk brokers GitHub sign-in for blog comments. Leave empty to run without
# comment auth (the composer degrades to a disabled state, and the Clerk-gated
# comment E2E tests skip). In Vercel, scope the development-instance keys to
# Preview and the production-instance keys to Production. The E2E suite requires
# development-instance keys (a production secret key is rejected by clerkSetup).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The +clerk_test reader account the Clerk-authenticated comment E2E tests sign
# in as (e.g. test+clerk_test@btnopen.com). Must exist in the Clerk development
# instance. There is no default: the sign-in and submit tests run only when this
# and both Clerk keys above are set, so leaving it empty skips them.
TEST_CLERK_READER_EMAIL=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Turns on Sentry error tracking and session replay. Leave empty to run without
# it; nothing is sent and no Sentry code initializes.
NEXT_PUBLIC_SENTRY_DSN=

# Turns on Mixpanel analytics, including autocapture. Leave empty to run without
# it — which is what local development and the e2e suite want, so test traffic
# never reaches the production project.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Identify the Sentry project that `next build` uploads source maps to. Only
# used at build time, and only when a Sentry auth token is present in the
# environment, so local builds need neither.
# SENTRY_ORG=
# SENTRY_PROJECT=

# ---------------------------------------------------------------------------
# End-to-end tests
# ---------------------------------------------------------------------------

# Points Playwright at an already-running deployment instead of starting a local
# dev server. Uncomment with a real origin (e.g. a preview URL) to run the suite
# against it; leaving it empty would set the base URL to an empty string rather
# than the local default.
# PLAYWRIGHT_BASE_URL=

# Serves the suite from a production build (`npm run build && npm run start`)
# instead of `next dev` when set to "production" — the mode the Check and Deploy
# workflow uses on `main`, so caching and compiler behaviour are exercised the
# way production runs them. Any other value, including empty, keeps the dev
# server. Ignored when PLAYWRIGHT_BASE_URL points the suite at a deployment.
PLAYWRIGHT_SERVER_MODE=

# Lets Playwright through Vercel Deployment Protection when PLAYWRIGHT_BASE_URL
# points at a protected preview. Leave empty for local runs.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Controls the scenario-coverage gate in `npm run coverage:scenarios`. Defaults
# to "must", which fails the run when a journey in `e2e/scenarios.md` has no
# covering test; any other value makes it report-only. Leaving it empty would
# silently downgrade the gate, which is why it stays commented.
# SCENARIO_GATE=

# ---------------------------------------------------------------------------
# Set for you — do not set these by hand
# ---------------------------------------------------------------------------
#
# The app reads these, but Vercel, the deploy workflows, and Next.js itself
# supply them. They are listed so the full set the code depends on is visible in
# one place; setting them locally misreports the environment to the app.
#
#   NEXT_PUBLIC_VERCEL_ENV               "production", "preview", or "development"
#   NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA    commit the deployment was built from
#   VERCEL_PROJECT_PRODUCTION_URL        production domain, used to build absolute URLs
#   VERCEL_BRANCH_URL                    stable per-branch preview host
#   VERCEL_URL                           unique per-deployment host
#   DEPLOYMENT_ID                        commit SHA the deploy workflows pass to
#                                        `next build` so Skew Protection survives
#                                        a prebuilt deployment
#   CI                                   set by GitHub Actions; tightens Playwright
#                                        and un-silences the Sentry build plugin
#   NEXT_RUNTIME                         "nodejs" or "edge", set by Next.js
#   NODE_ENV                             set by the Next.js CLI per command
#
# The deployment credentials the GitHub Actions workflows use — VERCEL_TOKEN,
# VERCEL_ORG_ID, VERCEL_PROJECT_ID, VERCEL_PREVIEW_ALIAS_PREFIX, TURSO_API_TOKEN,
# TURSO_GROUP — are repository secrets and variables, never local environment
# values. See docs/production-deployments.md and docs/preview-deployments.md.
