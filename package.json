{
  "name": "btnopen.com",
  "version": "0.1.0",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.0.0",
      "onFail": "warn"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "next dev | pino-pretty",
    "test:e2e": "playwright test",
    "coverage:scenarios": "playwright test && node e2e/check-scenario-coverage.mjs",
    "test:unit": "vitest run",
    "build": "bash -o pipefail -c 'next build | pino-pretty'",
    "start": "next start | pino-pretty",
    "migrate:status": "bash -o pipefail -c 'payload migrate:status | pino-pretty'",
    "migrate:create": "bash -o pipefail -c 'payload migrate:create | pino-pretty'",
    "migrate:up": "bash -o pipefail -c 'payload migrate | pino-pretty'",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.9.7",
    "@payloadcms/db-sqlite": "^3.90.2",
    "@payloadcms/live-preview-react": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/plugin-mcp": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-vercel-blob": "^3.90.2",
    "@payloadcms/ui": "^3.81.0",
    "@sentry/nextjs": "^10.69.0",
    "@shikijs/langs": "^3.22.0",
    "@shikijs/rehype": "^3.22.0",
    "@vercel/blob": "^2.8.0",
    "change-case": "^5.4.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "metascraper": "^5.58.1",
    "metascraper-description": "^5.56.2",
    "metascraper-image": "^5.56.2",
    "metascraper-title": "^5.56.2",
    "metascraper-url": "^5.56.2",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-util-combine-extensions": "^2.0.1",
    "mixpanel-browser": "^2.83.0",
    "next": "^16.3.1",
    "next-intl": "^4.14.7",
    "payload": "^3.81.0",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-react": "^8.0.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "shiki": "^3.22.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@clerk/testing": "^2.2.39",
    "@next/env": "^16.2.1",
    "@playwright/test": "^1.63.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "pino-pretty": "^13.1.3",
    "schema-dts": "^1.1.5",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^4.1.10"
  }
}
